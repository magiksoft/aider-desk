{
  "name": "ai-mock-provider",
  "version": "0.1.0",
  "description": "Mock provider for the Vercel AI SDK (LanguageModelV4): scenario-based canned responses (markdown headings, tables, math, code, JSON, files), lorem ipsum filler, streaming speed simulation in tokens per second driven by the user message, tool calls with schema-generated inputs, provider-executed tool results, multi-call scripts, reasoning and error simulation. Test streamText and generateText with no API key.",
  "author": "Magiksoft s.r.o.",
  "homepage": "https://aiderdesk.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/magiksoft/aider-desk.git",
    "directory": "packages/ai-mock-provider"
  },
  "bugs": {
    "url": "https://github.com/magiksoft/aider-desk/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:esm && npm run build:cjs && npm run build:types",
    "build:esm": "esbuild src/index.ts --bundle --platform=node --format=esm --external:@ai-sdk/provider --outfile=dist/index.mjs",
    "build:cjs": "esbuild src/index.ts --bundle --platform=node --format=cjs --external:@ai-sdk/provider --outfile=dist/index.cjs",
    "build:types": "tsc --noEmit false --emitDeclarationOnly --declaration --declarationMap --outDir dist/types -p tsconfig.build.json && node ./scripts/fix-types-extensions.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "harness": "esbuild src/harness/run-harness.ts --bundle --platform=node --format=cjs --outfile=dist-harness/run-harness.cjs && node dist-harness/run-harness.cjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel-ai-sdk",
    "vercel-ai",
    "ai-sdk-provider",
    "mock",
    "mock-llm",
    "mock-provider",
    "fake-llm",
    "fake",
    "llm",
    "testing",
    "streaming",
    "language-model",
    "tool-calling",
    "lorem-ipsum",
    "no-api-key"
  ],
  "peerDependencies": {
    "@ai-sdk/provider": ">=4.0.0 <5.0.0"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.39",
    "ai": "7.0.176"
  },
  "dependencies": {
    "lorem-ipsum": "^3.0.0"
  }
}
